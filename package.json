{
  "name": "yingyang",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test scripts/staging-policy.test.mjs scripts/production-policy.test.mjs",
    "build:staging": "tsc -b && vite build --mode staging && node scripts/staging-preview.mjs",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "deploy:production": "node scripts/deploy-production.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
