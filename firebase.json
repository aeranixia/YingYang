{
  "hosting": {
    "site": "yingyangcheck",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source":"**","destination":"/index.html"}],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" },{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"}]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  },
  "functions":[{"source":"functions","codebase":"yingyang-production","runtime":"nodejs22","ignore":["node_modules",".git","*-debug.log","*.test.*","test"]}]
}
