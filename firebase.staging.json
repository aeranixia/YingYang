{
  "hosting": {
    "site": "yingyangtest",
    "public": "dist-staging",
    "ignore": ["**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/staging.html" }],
    "headers": [{ "source": "**", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }]
  },
  "functions": [{
    "source": "functions",
    "codebase": "yingyang-staging",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "*-debug.log", "*.test.*", "test"]
  }]
}
